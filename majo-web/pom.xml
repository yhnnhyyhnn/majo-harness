<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.majo.harness</groupId>
    <artifactId>majo-harness-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>majo-web</artifactId>
  <name>majo-web</name>
  <description>Web profile app: JDK HTTP server over a booted harness, static chat UI (sessions sidebar + conversation + tool display) and a JSON turn API</description>

  <dependencies>
    <dependency>
      <groupId>io.majo.harness</groupId>
      <artifactId>majo-boot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.majo.harness</groupId>
      <artifactId>majo-headless</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.majo.harness</groupId>
      <artifactId>majo-todo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.majo.harness</groupId>
      <artifactId>majo-plan</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.yhnnhyyhnn</groupId>
      <artifactId>jcordis-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.yhnnhyyhnn</groupId>
      <artifactId>jcordis-loader</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- the version resource is filtered; everything else must stay raw
           (openapi.json / static UI would corrupt under ${...} substitution) -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>majo/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>majo/version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.majo.harness.web.WebMain</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
